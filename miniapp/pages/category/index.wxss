/* 分类页样式 */

.cat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #ffffff;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background-color: #ffffff;
  border-bottom: 2rpx solid #f0f0f0;
}

.search-box {
  flex: 1;
  display: flex;
  align-items: center;
  height: 68rpx;
  background-color: #f5f5f5;
  border-radius: 34rpx;
  padding: 0 24rpx;
}

.search-icon {
  font-size: 26rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #262626;
}

.search-clear {
  color: #bbbbbb;
  font-size: 26rpx;
  padding: 0 8rpx;
}

.search-btn {
  margin-left: 20rpx;
  color: #c8161d;
  font-size: 28rpx;
  font-weight: 600;
}

/* 主体：左树右列表 */
.cat-body {
  flex: 1;
  display: flex;
  overflow: hidden;
}

.side {
  width: 190rpx;
  height: 100%;
  background-color: #f7f7f7;
}

.side-item {
  padding: 32rpx 16rpx;
  font-size: 26rpx;
  color: #555555;
  text-align: center;
  border-left: 6rpx solid transparent;
}

.side-item-on {
  background-color: #ffffff;
  color: #c8161d;
  font-weight: 600;
  border-left-color: #c8161d;
}

.main {
  flex: 1;
  height: 100%;
  background-color: #ffffff;
  padding: 0 20rpx;
}

/* 二级分类横向标签 */
.sub-bar {
  white-space: nowrap;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.sub-tag {
  display: inline-block;
  padding: 8rpx 24rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background-color: #f5f5f5;
  color: #555555;
  font-size: 24rpx;
}

.sub-tag-on {
  background-color: rgba(200, 22, 29, 0.08);
  color: #c8161d;
  border: 2rpx solid rgba(200, 22, 29, 0.3);
}

.goods-list {
  padding-bottom: 40rpx;
}

.list-end {
  text-align: center;
  color: #bbbbbb;
  font-size: 24rpx;
  padding: 30rpx 0;
}
