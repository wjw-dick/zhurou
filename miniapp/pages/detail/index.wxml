<!-- 商品详情页 -->
<view class="page-nopad" wx:if="{{product}}">

  <!-- 主图轮播 -->
  <swiper class="gallery" indicator-dots="{{images.length > 1}}" circular="{{images.length > 1}}" indicator-active-color="#c8161d">
    <swiper-item wx:for="{{images}}" wx:key="*this">
      <image class="gallery-img" src="{{item}}" mode="aspectFill" bindtap="previewImage" data-src="{{item}}" />
    </swiper-item>
    <swiper-item wx:if="{{!images.length}}">
      <view class="gallery-img thumb-placeholder">暂无图片</view>
    </swiper-item>
  </swiper>

  <view class="page">
    <!-- 价格与名称 -->
    <view class="card">
      <view class="row-between">
        <view class="price">
          <text class="price-symbol">¥</text>
          <text class="price-num">{{product.salePrice || product.price}}</text>
          <text class="price-origin" wx:if="{{product.marketPrice}}">¥{{product.marketPrice}}</text>
        </view>
        <text class="text-muted">已售{{product.sales || 0}}{{product.unit || '份'}}</text>
      </view>
      <view class="goods-name" style="font-size:34rpx;margin-top:12rpx;">{{product.productName || product.name}}</view>
      <view class="goods-desc" wx:if="{{product.subTitle}}">{{product.subTitle}}</view>

      <view class="tag-row">
        <text wx:if="{{product.reservable}}" class="tag tag-gold">可鲜肉预订</text>
        <text wx:if="{{product.bizType}}" class="tag tag-red">{{product.bizType}}</text>
        <text wx:if="{{product.origin}}" class="tag tag-gray">{{product.origin}}</text>
      </view>
    </view>

    <!-- 规格选择 -->
    <view class="card" wx:if="{{skus.length}}">
      <view class="section-title">选择规格</view>
      <view class="sku-list">
        <view
          class="sku-item {{selectedSkuIndex === index ? 'sku-item-on' : ''}}"
          wx:for="{{skus}}"
          wx:key="id"
          bindtap="onSkuTap"
          data-index="{{index}}"
        >
          <text class="sku-name">{{item.skuName || item.name}}</text>
          <text class="sku-price">¥{{item.price}}</text>
        </view>
      </view>
    </view>

    <!-- 商品参数 -->
    <view class="card">
      <view class="section-title">商品信息</view>
      <view class="param-row">
        <text class="param-label">产地</text>
        <text class="param-value">{{product.origin || '—'}}</text>
      </view>
      <view class="param-row">
        <text class="param-label">保质期</text>
        <text class="param-value">{{product.shelfLife || '—'}}</text>
      </view>
      <view class="param-row">
        <text class="param-label">储存方式</text>
        <text class="param-value">{{product.storage || '—'}}</text>
      </view>
      <view class="param-row">
        <text class="param-label">净含量</text>
        <text class="param-value">{{product.weight ? product.weight + (product.weightUnit || 'kg') : '—'}}</text>
      </view>
      <view class="param-row">
        <text class="param-label">烹饪提示</text>
        <text class="param-value">{{product.cookingTip || product.cooking || '—'}}</text>
      </view>
    </view>

    <!-- 检疫资质标签 -->
    <view class="card">
      <view class="section-title">检疫与品质资质</view>
      <view class="qual-list" wx:if="{{qualifications.length}}">
        <view
          class="qual-item"
          wx:for="{{qualifications}}"
          wx:key="id"
          bindtap="previewQual"
          data-item="{{item}}"
        >
          <view class="qual-badge">✓</view>
          <view class="flex-1">
            <view class="qual-name">{{item.qualName || item.qualTypeName || (item.qualType === 'QUARANTINE' ? '动物产品检疫合格证明' : item.qualType)}}</view>
            <view class="text-muted ellipsis" wx:if="{{item.qualNo}}">编号：{{item.qualNo}}</view>
          </view>
          <text class="qual-view" wx:if="{{item.fileUrl || item.imageUrl || item.certUrl}}">查看 ›</text>
        </view>
      </view>
      <view wx:else class="text-muted">该商品暂未上传资质文件</view>
      <view class="qual-tip">每批次均附动物检疫合格证明，可放心购买</view>
    </view>

    <!-- 图文详情 -->
    <view class="card" wx:if="{{product.detail || product.description}}">
      <view class="section-title">商品详情</view>
      <rich-text nodes="{{product.detail || product.description}}"></rich-text>
    </view>
  </view>

  <view class="footer-holder"></view>

  <!-- 底部操作栏 -->
  <view class="footer-bar">
    <view class="bar-icon" bindtap="contact">
      <text class="bar-icon-emoji">💬</text>
      <text class="bar-icon-text">客服</text>
    </view>
    <view class="bar-icon" bindtap="goCart">
      <text class="bar-icon-emoji">🛒</text>
      <text class="bar-icon-text">购物车</text>
      <text wx:if="{{cartCount}}" class="bar-badge">{{cartCount}}</text>
    </view>
    <view class="btn btn-gold bar-btn" bindtap="openSheet" data-mode="reserve" wx:if="{{product.reservable}}">鲜肉预订</view>
    <view class="btn btn-plain bar-btn" bindtap="openSheet" data-mode="cart">加入购物车</view>
    <view class="btn btn-primary bar-btn" bindtap="openSheet" data-mode="buy">立即购买</view>
  </view>

  <!-- 底部弹层：规格 / 数量 / 分割方式 -->
  <view wx:if="{{showSheet}}" class="sheet-mask" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <image wx:if="{{images[0]}}" class="sheet-img" src="{{images[0]}}" mode="aspectFill" />
        <view wx:else class="sheet-img thumb-placeholder">图</view>
        <view class="flex-1">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{selectedSku.price || product.salePrice || product.price}}</text>
          </view>
          <view class="text-muted ellipsis">已选：{{selectedSku.skuName || selectedSku.name || '默认规格'}} × {{quantity}}</view>
          <view class="text-muted" wx:if="{{mode === 'reserve'}}">分割：{{splitType === 'CUBE' ? '切块' : splitType === 'MINCED' ? '绞肉' : splitType === 'SLICED' ? '切片' : '不分割'}}</view>
        </view>
        <text class="sheet-close" bindtap="closeSheet">✕</text>
      </view>

      <scroll-view scroll-y class="sheet-body">
        <!-- 规格 -->
        <view wx:if="{{skus.length}}" class="sheet-block">
          <view class="sheet-label">规格</view>
          <view class="sku-list">
            <view
              class="sku-item {{selectedSkuIndex === index ? 'sku-item-on' : ''}}"
              wx:for="{{skus}}"
              wx:key="id"
              bindtap="onSkuTap"
              data-index="{{index}}"
            >
              <text class="sku-name">{{item.skuName || item.name}}</text>
              <text class="sku-price">¥{{item.price}}</text>
            </view>
          </view>
        </view>

        <!-- 鲜肉预订：日期 + 分割方式 -->
        <block wx:if="{{mode === 'reserve'}}">
          <view class="sheet-block">
            <view class="sheet-label">预订日期</view>
            <view class="option-list">
              <view
                class="option-item {{reserveDate === item.value ? 'option-item-on' : ''}}"
                wx:for="{{reserveDates}}"
                wx:key="value"
                bindtap="onDateTap"
                data-value="{{item.value}}"
              >
                {{item.label}}
              </view>
            </view>
          </view>
          <view class="sheet-block">
            <view class="sheet-label">分割方式</view>
            <view class="option-list">
              <view
                class="option-item {{splitType === item.value ? 'option-item-on' : ''}}"
                wx:for="{{splitTypes}}"
                wx:key="value"
                bindtap="onSplitTap"
                data-value="{{item.value}}"
              >
                {{item.label}}<text wx:if="{{item.fee > 0}}" class="option-fee">+¥{{item.fee}}</text>
              </view>
            </view>
          </view>
        </block>

        <!-- 数量 -->
        <view class="sheet-block row-between">
          <view class="sheet-label" style="margin-bottom:0">数量</view>
          <view class="stepper">
            <view class="stepper-btn" bindtap="minus">−</view>
            <input class="stepper-num" type="number" value="{{quantity}}" bindinput="onQuantityInput" />
            <view class="stepper-btn stepper-btn-on" bindtap="plus">＋</view>
          </view>
        </view>
      </scroll-view>

      <view class="sheet-foot">
        <view class="btn btn-primary" style="width:100%" bindtap="onSheetConfirm">
          {{mode === 'reserve' ? '立即预订' : (mode === 'buy' ? '立即购买' : '加入购物车')}}
        </view>
      </view>
    </view>
  </view>
</view>

<view wx:elif="{{loading}}" class="empty">
  <text class="empty-icon">⏳</text>
  加载中…
</view>
<view wx:else class="empty">
  <text class="empty-icon">🐷</text>
  商品不存在或已下架
</view>
