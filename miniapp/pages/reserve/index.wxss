/* 鲜肉预订页样式 */

.rs-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

/* 日期选项 */
.option-list {
  display: flex;
  flex-wrap: wrap;
}

.option-item {
  min-width: 160rpx;
  padding: 16rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  background-color: #f7f7f7;
  border: 2rpx solid transparent;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.option-item-on {
  background-color: rgba(200, 22, 29, 0.06);
  border-color: #c8161d;
}

.option-label {
  font-size: 28rpx;
  color: #333333;
}

.option-item-on .option-label {
  color: #c8161d;
  font-weight: 600;
}

.option-sub {
  font-size: 22rpx;
  color: #999999;
  margin-top: 4rpx;
}

.stock-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666666;
}

/* 预订按钮 */
.mini-btn {
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  background-color: #c8161d;
  color: #ffffff;
  font-size: 26rpx;
}

/* 预订说明 */
.reserve-note {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.note-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #c8161d;
  margin-bottom: 12rpx;
}

.note-item {
  font-size: 24rpx;
  color: #888888;
  line-height: 1.8;
}

/* 弹层通用 */
.sheet-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.45);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.sheet {
  width: 100%;
  background-color: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  padding: 30rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.sheet-scroll {
  max-height: 56vh;
  padding: 0 24rpx;
}

.store-option {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.store-option-on {
  background-color: #fdf3f3;
  border-radius: 12rpx;
}

.sheet-head {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 2rpx solid #f2f2f2;
  position: relative;
}

.sheet-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  margin-right: 20rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.sheet-close {
  position: absolute;
  top: 16rpx;
  right: 24rpx;
  font-size: 30rpx;
  color: #bbbbbb;
}

.sheet-body {
  max-height: 50vh;
  padding: 24rpx;
}

.sheet-block {
  margin-bottom: 28rpx;
}

.sheet-label {
  font-size: 28rpx;
  color: #333333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.option-fee {
  font-size: 22rpx;
  color: #d4a35b;
  margin-left: 6rpx;
}

.sheet-foot {
  padding: 16rpx 24rpx 24rpx;
}
