/* 确认下单样式 */

.seg {
  display: flex;
  background-color: #f5f5f5;
  border-radius: 14rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666666;
  border-radius: 12rpx;
}

.seg-item-on {
  background-color: #ffffff;
  color: #c8161d;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.08);
}

.store-line {
  display: flex;
  align-items: flex-start;
  padding: 16rpx 0 8rpx;
}

.rs-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
  line-height: 1.2;
}

.amount-row {
  padding: 14rpx 0;
}

.submit-btn {
  width: 280rpx;
  height: 80rpx;
}
