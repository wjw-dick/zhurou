/* 订单详情样式 */

.status-head {
  background: linear-gradient(135deg, #c8161d, #e04a4f);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
}

.status-text {
  font-size: 40rpx;
  font-weight: 600;
}

.status-sub {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.85) !important;
}

.copy {
  color: #ffe6b0;
  margin-left: 12rpx;
}

.info-line {
  display: flex;
  padding: 14rpx 0;
  border-bottom: 2rpx solid #f7f7f7;
}

.info-line:last-child {
  border-bottom: none;
}

.info-label {
  width: 160rpx;
  color: #999999;
  font-size: 26rpx;
  flex-shrink: 0;
}

.info-value {
  flex: 1;
  color: #333333;
  font-size: 26rpx;
}

.amount-row {
  padding: 14rpx 0;
}
