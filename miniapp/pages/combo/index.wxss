/* 火锅套餐 / 礼盒专区样式 */

.combo-banner {
  background: linear-gradient(135deg, #c8161d, #d4a35b);
  border-radius: 16rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 20rpx;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(200, 22, 29, 0.22);
}

.combo-title {
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.combo-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.filter-bar {
  white-space: nowrap;
  margin-bottom: 20rpx;
}

.filter-tag {
  display: inline-block;
  padding: 12rpx 32rpx;
  margin-right: 16rpx;
  border-radius: 30rpx;
  background-color: #ffffff;
  color: #555555;
  font-size: 26rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.filter-tag-on {
  background-color: #c8161d;
  color: #ffffff;
}

.combo-card {
  display: flex;
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.combo-img {
  width: 220rpx;
  height: 220rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.combo-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.buy-btn {
  padding: 8rpx 28rpx;
  border-radius: 28rpx;
  background-color: rgba(200, 22, 29, 0.08);
  color: #c8161d;
  font-size: 24rpx;
  border: 2rpx solid rgba(200, 22, 29, 0.3);
}

.list-end {
  text-align: center;
  color: #bbbbbb;
  font-size: 24rpx;
  padding: 30rpx 0;
}
