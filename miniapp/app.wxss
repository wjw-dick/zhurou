/**
 * 全局样式
 * 主色：中国红 #c8161d
 * 辅色：暖金 #d4a35b
 * 单位统一使用 rpx，卡片圆角 16rpx，阴影柔和。
 */

page {
  background-color: #f5f5f5;
  color: #262626;
  font-size: 28rpx;
  line-height: 1.5;
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", Helvetica, Arial, sans-serif;
}

view,
text,
image,
button,
input,
textarea {
  box-sizing: border-box;
}

/* ============ 布局 ============ */
.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 40rpx;
}

.page-nopad {
  min-height: 100vh;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.col {
  display: flex;
  flex-direction: column;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ============ 卡片 ============ */
.card {
  background-color: #ffffff;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.card-flat {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

/* ============ 标题 ============ */
.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #262626;
  margin-bottom: 20rpx;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 30rpx;
  background-color: #c8161d;
  border-radius: 4rpx;
  margin-right: 12rpx;
  vertical-align: -4rpx;
}

.section-more {
  font-size: 24rpx;
  color: #999999;
}

/* ============ 文字 ============ */
.text-muted {
  color: #999999;
  font-size: 24rpx;
}

.text-main {
  color: #c8161d;
}

.text-gold {
  color: #d4a35b;
}

.text-bold {
  font-weight: 600;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

/* ============ 价格 ============ */
.price {
  color: #c8161d;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 36rpx;
}

.price-origin {
  color: #bbbbbb;
  font-size: 24rpx;
  text-decoration: line-through;
  margin-left: 12rpx;
}

/* ============ 按钮 ============ */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
}

.btn-primary {
  background-color: #c8161d;
  color: #ffffff;
}

.btn-gold {
  background-color: #d4a35b;
  color: #ffffff;
}

.btn-plain {
  background-color: #ffffff;
  color: #c8161d;
  border: 2rpx solid #c8161d;
}

.btn-disabled {
  background-color: #cccccc !important;
  color: #ffffff !important;
}

/* ============ 标签 ============ */
.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  line-height: 32rpx;
}

.tag-red {
  color: #c8161d;
  background-color: rgba(200, 22, 29, 0.08);
  border: 2rpx solid rgba(200, 22, 29, 0.25);
}

.tag-gold {
  color: #b07d2c;
  background-color: rgba(212, 163, 91, 0.15);
  border: 2rpx solid rgba(212, 163, 91, 0.4);
}

.tag-green {
  color: #2e9e5b;
  background-color: rgba(46, 158, 91, 0.1);
  border: 2rpx solid rgba(46, 158, 91, 0.3);
}

.tag-gray {
  color: #888888;
  background-color: #f2f2f2;
}

/* ============ 商品项（列表通用） ============ */
.goods-item {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}

.goods-item:last-child {
  border-bottom: none;
}

.goods-thumb {
  width: 180rpx;
  height: 180rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.goods-thumb-sm {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background-color: #f5f5f5;
  flex-shrink: 0;
}

.goods-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.goods-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #262626;
}

.goods-desc {
  font-size: 24rpx;
  color: #999999;
  margin-top: 8rpx;
}

/* 无图占位 */
.thumb-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #fdf3f3;
  color: #c8161d;
  font-size: 24rpx;
}

/* ============ 空状态 ============ */
.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #bbbbbb;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 90rpx;
  display: block;
  margin-bottom: 20rpx;
}

/* ============ 底部操作栏 ============ */
.footer-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background-color: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.06);
}

.footer-holder {
  height: 140rpx;
}

/* ============ 分区标题条 ============ */
.divider {
  height: 2rpx;
  background-color: #f0f0f0;
  margin: 20rpx 0;
}

/* ============ 表单行 ============ */
.form-row {
  display: flex;
  align-items: center;
  min-height: 88rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 160rpx;
  color: #333333;
  font-size: 28rpx;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
  color: #262626;
  text-align: right;
}

.form-input-left {
  text-align: left;
}

/* ============ 数量步进器 ============ */
.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 48rpx;
  text-align: center;
  border-radius: 50%;
  border: 2rpx solid #dddddd;
  color: #666666;
  font-size: 32rpx;
}

.stepper-btn-on {
  border-color: #c8161d;
  color: #c8161d;
}

.stepper-num {
  min-width: 70rpx;
  text-align: center;
  font-size: 28rpx;
}
