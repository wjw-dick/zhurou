<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.zhushi</groupId>
    <artifactId>zhushi-daji</artifactId>
    <version>1.0.0</version>
  </parent>
  <artifactId>zhushi-admin</artifactId>
  <name>zhushi-admin</name>
  <description>启动模块：聚合全部业务模块，提供 REST API</description>
  <dependencies>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-system</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-cms</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-store</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-product</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-reserve</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-order</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-member</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-supplier</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-channel</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-staff</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-pay</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-wechat</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-oss</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zhushi</groupId>
      <artifactId>zhushi-portal</artifactId>
    </dependency>
  </dependencies>
  <build>
    <finalName>zhushi-admin</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <configuration>
          <mainClass>com.zhushi.admin.ZhushiAdminApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
