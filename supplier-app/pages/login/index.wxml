<view class="login">
  <view class="brand">
    <view class="logo">猪事大吉</view>
    <view class="brand-sub">供应商管理端</view>
  </view>

  <view class="form">
    <view class="field">
      <text class="field-label">账号</text>
      <input class="field-input" placeholder="请输入登录账号" value="{{username}}" bindinput="onUsernameInput" />
    </view>
    <view class="field">
      <text class="field-label">密码</text>
      <input
        class="field-input"
        password
        placeholder="请输入登录密码"
        value="{{password}}"
        bindinput="onPasswordInput"
      />
    </view>
    <button class="btn-primary submit" disabled="{{submitting}}" bindtap="onSubmit">
      {{submitting ? '登录中…' : '登 录'}}
    </button>
    <view class="tip">账号密码由平台后台创建并绑定供应商，如无法登录请联系业务对接人</view>
  </view>
</view>
