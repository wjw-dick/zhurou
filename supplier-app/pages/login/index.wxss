.login {
  min-height: 100vh;
  padding: 0 60rpx;
  background: linear-gradient(180deg, #c8161d 0%, #c8161d 320rpx, #f6f6f8 320rpx, #f6f6f8 100%);
}

.brand {
  padding: 130rpx 0 90rpx;
  color: #fff;
}

.logo {
  font-size: 58rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.brand-sub {
  margin-top: 14rpx;
  font-size: 26rpx;
  opacity: 0.88;
}

.form {
  padding: 40rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.field {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.field-label {
  width: 110rpx;
  color: #666;
  font-size: 28rpx;
}

.field-input {
  flex: 1;
  font-size: 28rpx;
}

.submit {
  margin-top: 50rpx;
}

.tip {
  margin-top: 30rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: #999;
  text-align: center;
}
