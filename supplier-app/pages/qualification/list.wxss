page {
  padding-bottom: 160rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
}

.cert-img {
  width: 100%;
  height: 320rpx;
  margin-top: 16rpx;
  border-radius: 12rpx;
  background: #f2f2f2;
}

.card-foot {
  margin-top: 14rpx;
  text-align: right;
}

.link {
  font-size: 26rpx;
  color: #c8161d;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
