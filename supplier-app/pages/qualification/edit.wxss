page {
  padding-bottom: 160rpx;
}

.form-row {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.form-row:last-child {
  border-bottom: none;
}

.form-label {
  width: 180rpx;
  color: #666;
  font-size: 28rpx;
}

.form-input {
  flex: 1;
  font-size: 28rpx;
}

.picker-value {
  min-width: 240rpx;
  font-size: 28rpx;
  color: #222;
}

.upload {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 320rpx;
  height: 220rpx;
  border: 1rpx dashed #d9d9d9;
  border-radius: 12rpx;
  overflow: hidden;
  background: #fafafa;
}

.upload-img {
  width: 100%;
  height: 100%;
}

.upload-placeholder {
  color: #999;
  font-size: 26rpx;
}

.upload-tip {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #aaa;
  line-height: 1.6;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
