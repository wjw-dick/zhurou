/* 为底部固定操作条预留空间 */
page {
  padding-bottom: 140rpx;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.order-no {
  font-size: 30rpx;
  font-weight: 600;
}

.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f2f2f2;
}

.item:last-child {
  border-bottom: none;
}

.item-left {
  flex: 1;
  min-width: 0;
}

.item-name {
  font-size: 28rpx;
}

.item-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.item-right {
  flex: none;
  text-align: right;
}

.item-qty {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 30rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
