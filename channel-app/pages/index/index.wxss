.header {
  padding: 40rpx 30rpx 70rpx;
  background: linear-gradient(135deg, #c8161d, #e8434a);
  color: #fff;
}

.hello {
  font-size: 40rpx;
  font-weight: 700;
}

.hello-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.stats {
  display: flex;
  flex-wrap: wrap;
  padding: 0 20rpx;
  margin-top: -50rpx;
}

.stat-card {
  width: calc(50% - 20rpx);
  margin: 10rpx;
  padding: 26rpx 20rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.stat-card.wide {
  width: calc(100% - 20rpx);
}

.stat-num {
  font-size: 42rpx;
  font-weight: 700;
  color: #c8161d;
}

.stat-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #888;
}

.entry-grid {
  display: flex;
}

.entry {
  flex: 1;
  text-align: center;
  padding: 10rpx 0;
}

.entry-icon {
  font-size: 44rpx;
}

.entry-text {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #555;
}

.tip-text {
  margin: 30rpx 0 60rpx;
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
}
