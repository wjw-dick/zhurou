.summary {
  display: flex;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #c8161d, #e8434a);
}

.summary-item {
  flex: 1;
  text-align: center;
  color: #fff;
}

.summary-num {
  font-size: 40rpx;
  font-weight: 700;
}

.summary-label {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.order-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 14rpx;
}

.order-no {
  font-size: 28rpx;
  font-weight: 600;
}
