<view class="list">
  <view class="card" wx:for="{{list}}" wx:key="id">
    <view class="order-head">
      <text class="order-no">{{item.name || ('渠道 #' + item.id)}}</text>
      <text class="tag tag-orange">{{channelTypeLabel[item.channelType] || item.channelType}}</text>
    </view>
    <view class="row">
      <text class="label">渠道编码</text>
      <text class="value">{{item.code || '-'}}</text>
    </view>
    <view class="row">
      <text class="label">联系人 / 电话</text>
      <text class="value">{{item.contact || '-'}} {{item.phone || ''}}</text>
    </view>
    <view class="row">
      <text class="label">默认佣金比例</text>
      <text class="price">{{item.commissionRate || 0}}%</text>
    </view>
    <view class="row">
      <text class="label">层级</text>
      <text class="value">第 {{item.level || 1}} 级</text>
    </view>
    <view class="row">
      <text class="label">状态</text>
      <text class="value">{{item.status === 0 ? '已停用' : '正常'}}</text>
    </view>
  </view>
</view>

<view class="empty" wx:if="{{!loading && !list.length}}">暂无下级渠道</view>
<view class="empty" wx:if="{{finished && list.length}}">— 已经到底啦 —</view>
<view class="empty" wx:if="{{loading}}">加载中…</view>
