.profile {
  display: flex;
  align-items: center;
  padding: 50rpx 30rpx;
  background: linear-gradient(135deg, #c8161d, #e8434a);
  color: #fff;
}

.avatar {
  width: 110rpx;
  height: 110rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 44rpx;
  line-height: 110rpx;
  text-align: center;
}

.name {
  font-size: 34rpx;
  font-weight: 600;
}

.role {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.88;
}

.logout-wrap {
  padding: 40rpx 30rpx 80rpx;
}
